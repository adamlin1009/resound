{
  "name": "resound",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "prisma generate && next build --webpack",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma db push --force-reset && npm run seed",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest --testPathPatterns=api",
    "test:db": "jest --testPathPatterns=__tests__/db",
    "test:e2e": "jest --testPathPatterns=e2e",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^4.12.0",
    "@stripe/stripe-js": "^7.3.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.0.31",
    "@types/react-dom": "18.0.11",
    "@uploadthing/react": "^7.3.3",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.0",
    "axios": "^1.3.4",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.29.3",
    "dotenv": "^16.5.0",
    "framer-motion": "^10.10.0",
    "leaflet": "^1.9.4",
    "mongodb": "^6.17.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "plaiceholder": "^3.0.0",
    "qrcode": "^1.5.4",
    "query-string": "^8.1.0",
    "react": "18.2.0",
    "react-date-range": "^1.4.0",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.43.9",
    "react-icons": "^4.12.0",
    "react-leaflet": "^4.2.1",
    "react-select": "^5.7.2",
    "react-toastify": "^9.1.3",
    "react-world-flags": "^1.5.1",
    "resend": "^4.5.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^18.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^3.0.0",
    "uploadthing": "^7.7.4",
    "world-countries": "^4.0.0",
    "zustand": "^4.3.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.3",
    "@types/node": "^20.19.40",
    "@types/react-date-range": "^1.4.4",
    "@types/react-world-flags": "^1.4.2",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jest": "^30.4.0",
    "jest-environment-jsdom": "^30.4.0",
    "postcss": "^8.5.4",
    "prisma": "^4.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
